# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env.

# --- Runtime ---
# development | test | production. docker-compose.yml forces production, which refuses
# to start with a placeholder or short (< 32 chars) SECRET_KEY.
ENV=development

# --- Postgres container (used by the `db` service in docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=project_verification

# --- Database ---
# Local (non-Docker) dev. docker-compose overrides this to point at host `db`.
DATABASE_URL=postgresql://postgres:change-me-db-password@localhost:5432/project_verification

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# REQUIRED for docker compose (ENV=production rejects this placeholder).
SECRET_KEY=your-secret-key-change-in-production
# Pinned: any value other than HS256 is rejected at startup.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Where the backend redirects after OAuth (Vite dev port; prod compose overrides to :3000)
FRONTEND_URL=http://localhost:5173
# JSON list of CORS origins
ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Scanner ---
# Scratch directory for shallow clones (must be writable by the backend user).
# Stale scan-* entries are purged on startup; compose mounts it as a 1 GiB tmpfs.
SCAN_WORKDIR=/tmp/project-verification
# Budget for metadata check + clone + tree check + checkout
SCAN_CLONE_TIMEOUT_SECONDS=60
# Overall wall-clock budget for one scan (clone + all checks)
SCAN_TOTAL_TIMEOUT_SECONDS=120
# Enforced on GitHub's reported size before cloning AND on the tree before checkout
SCAN_MAX_REPO_SIZE_MB=200
# Max entries in the repository tree (checked before checkout)
SCAN_MAX_FILES=50000
# Scans run on a dedicated thread pool of this many workers
SCAN_CONCURRENCY=2
# Global cap on queued + running scans across all users (429 "scanner is busy")
SCAN_MAX_QUEUED=20
SCANS_PER_HOUR_PER_USER=10
MAX_PROJECTS_PER_USER=50
# Optional: GitHub token used ONLY for the pre-clone metadata API call (raises the
# 60 req/h unauthenticated rate limit). It is never sent to git, and private
# repositories are always rejected. Use a token with no scopes / public access only.
GITHUB_TOKEN=

# --- Frontend (baked into the build at build time) ---
VITE_API_URL=http://localhost:8000
